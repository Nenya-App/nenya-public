{
  // Used only to type-check (`npm run typecheck`); Vite builds the site and Node strips types for the tests.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/app/*"] }
  },
  "include": ["src", "netlify", "tests/**/*.mts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist"]
}
