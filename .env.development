# Local `npm run dev` only (Vite loads this file in development mode, never in a build): the lens vocabulary, the lens tray and the Terms-first entry on,
# matching the dev branch's deploys (netlify.toml, [context.dev.environment]). No secrets here. Delete a line to see that switch off.
VITE_LENS_COPY=on
VITE_LENS_TRAY=on
VITE_TERMS_FIRST=on
VITE_LENS_TAPESTRY=on
VITE_LENS_PATH=on
VITE_SUMMARY_REQUEST=on
