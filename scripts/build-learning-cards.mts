// Builds src/lib/learningCardsData.ts from a folder of card files (Markdown). Only cards whose front matter says `status: approved` are included, and each must
// pass every rule in cardProblems(). A card that is approved but breaks a rule stops the build and says why, so nothing unchecked ships.
//   node scripts/build-learning-cards.mts <folder-of-cards>
import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { parseCard } from '../src/lib/learningCards.ts';

const dir = process.argv[2];
if (!dir) { console.error('usage: build-learning-cards.mts <folder>'); process.exit(1); }
const approved = [];
let skipped = 0;
for (const f of readdirSync(dir).filter((x) => /^(prop|dehum|conn|ai)-\d\d-.*\.md$/.test(x)).sort()) {
  const r = parseCard(readFileSync(join(dir, f), 'utf8'));
  if (!r) { console.error(`${f}: not in the expected shape`); process.exit(1); }
  if (r.status !== 'approved') { skipped++; continue; }
  if (r.problems.length) { console.error(`${f} is marked approved but cannot ship: ${r.problems.join('; ')}`); process.exit(1); }
  approved.push(r.card);
}
const out = `// GENERATED by scripts/build-learning-cards.mts from the owner-approved cards. Only cards marked approved are ever in this file.\nimport type { LearningCard } from './learningCards.ts';\n\nexport const LEARNING_CARDS_DATA: LearningCard[] = ${JSON.stringify(approved, null, 2)};\n`;
writeFileSync(new URL('../src/lib/learningCardsData.ts', import.meta.url), out);
console.log(`${approved.length} approved card(s) written; ${skipped} not approved and left out.`);
