// A breathing pace of your own (src/lib/breathCustom.ts, CustomBreath.tsx): whole seconds inside limits, applied on a press, kept with the other settings, and the default is 6 and 6.
import { readFileSync } from 'node:fs';
import { BREATH_LIMITS, isAllowedTechnique, paceLabel, secondsOf, validateCustom } from '../src/lib/breathCustom.ts';
import { PRESETS, sameTechnique } from '../src/lib/breathingPresets.ts';
import { ok } from './helpers.mts';

const good = validateCustom({ ih: 6, hi: 0, ex: 8, ho: 0 });
ok('four numbers of seconds inside the limits make a pace, in milliseconds, with the cycle and breaths a minute said', good.ok && JSON.stringify(good.technique) === JSON.stringify({ ih: 6000, hi: 0, ex: 8000, ho: 0 }) && good.cycleS === 14 && good.perMinute === 4.3 && good.problems.length === 0);
ok('text typed in boxes is accepted when it is a whole number', validateCustom({ ih: '4', hi: '4', ex: '4', ho: '4' }).ok);
ok('the limits: inhale 2 to 12, hold 0 to 12, exhale 2 to 16, hold 0 to 12, whole breath 4 to 40', BREATH_LIMITS.ih.min === 2 && BREATH_LIMITS.ih.max === 12 && BREATH_LIMITS.ex.max === 16 && BREATH_LIMITS.hi.min === 0 && BREATH_LIMITS.cycle.min === 4 && BREATH_LIMITS.cycle.max === 40);
const bad = [validateCustom({ ih: 1, hi: 0, ex: 6, ho: 0 }), validateCustom({ ih: 13, hi: 0, ex: 6, ho: 0 }), validateCustom({ ih: 6, hi: 0, ex: 17, ho: 0 }), validateCustom({ ih: 6, hi: -1, ex: 6, ho: 0 }), validateCustom({ ih: 6.5, hi: 0, ex: 6, ho: 0 }), validateCustom({ ih: '', hi: 0, ex: 6, ho: 0 }), validateCustom({ ih: 'x', hi: 0, ex: 6, ho: 0 })];
ok('out of range, not whole, empty and not a number are each refused with a plain sentence and no pace', bad.every((c) => !c.ok && c.technique === null && c.problems.length >= 1 && c.problems.every((p) => /seconds|number/.test(p))));
ok('a whole breath that is too long or too short is refused even when each phase is allowed', !validateCustom({ ih: 12, hi: 12, ex: 16, ho: 12 }).ok && /between 4 and 40/.test(validateCustom({ ih: 12, hi: 12, ex: 16, ho: 12 }).problems[0]) && !validateCustom({ ih: 2, hi: 0, ex: 2, ho: 0 }).ok === false);
ok('every preset is an allowed pace', PRESETS.every((p) => isAllowedTechnique({ ih: p.ih, hi: p.hi, ex: p.ex, ho: p.ho })));
ok('what a damaged or edited save says is not allowed: zero inhale, a quarter second, a pace too long, junk', !isAllowedTechnique({ ih: 0, hi: 0, ex: 5000, ho: 0 }) && !isAllowedTechnique({ ih: 5250, hi: 0, ex: 5000, ho: 0 }) && !isAllowedTechnique({ ih: 60000, hi: 0, ex: 60000, ho: 0 }) && !isAllowedTechnique('x') && !isAllowedTechnique(null));
ok('the default is six seconds in and six out (Steady 6·6), and 5·5 stays as a preset called Resonance', sameTechnique(PRESETS[0], { ih: 6000, hi: 0, ex: 6000, ho: 0 }) && PRESETS[0].lb === '6·6' && PRESETS.some((p) => p.lb === '5·5'));
ok('a pace reads back as seconds and as a short label', JSON.stringify(secondsOf({ ih: 4000, hi: 7000, ex: 8000, ho: 0 })) === JSON.stringify({ ih: 4, hi: 7, ex: 8, ho: 0 }) && paceLabel({ ih: 4000, hi: 7000, ex: 8000, ho: 0 }) === '4·7·8·0');
const comp = readFileSync('src/app/components/CustomBreath.tsx', 'utf8'), pop = readFileSync('src/app/components/BreathingPopout.tsx', 'utf8'), pb = readFileSync('src/app/components/PortableBreath.tsx', 'utf8'), dm = readFileSync('src/lib/deviceMemory.ts', 'utf8');
ok('nothing changes until Apply is pressed, and Apply is off while the numbers are not allowed', /onClick=\{apply\} disabled=\{!check\.ok\}/.test(comp) && /if \(check\.technique\) \{ onApply\(check\.technique\)/.test(comp) && !/onChange=\{\(e\) => onApply/.test(comp));
ok('the boxes are labelled, 44px, say their limits, and the result is a polite status', /htmlFor=\{`\$\{id\}-\$\{k\}`\}/.test(comp) && /h-11/.test(comp) && /BREATH_LIMITS\[k\]\.min\} to \{BREATH_LIMITS\[k\]\.max\} seconds/.test(comp) && /role="status" aria-live="polite"/.test(comp) && /Back to the default/.test(comp));
ok('it sits in the breathing settings next to the presets, and a custom pace is named as the person\'s own', /<CustomBreath technique=\{technique\} onApply=\{onTechniqueChange\} steady=\{STEADY\}/.test(pop) && /Your own pace: \$\{paceLabel\(technique\)\} seconds/.test(pop) && /Your own pace: \{IH \/ 1000\}/.test(readFileSync('src/app/components/BreathingCounter.tsx', 'utf8')));
ok('it is kept with the other display settings (the same saved preference, only with Remember on this device) and checked when read back', /usePref\('breathingTechnique'/.test(pb) && /breathingTechnique: \(v\) => \{[\s\S]{0,200}isAllowedTechnique\(v\)/.test(dm) && /ih: 6000, hi: 0, ex: 6000, ho: 0/.test(pb));
