import { NIGHTLY_CEILING, canaryAllowance, FREE_NEURONS_PER_DAY, MARGIN, NEURONS_PER_RUN, NEURONS_PER_TURN, runsThatFit, unusedNeurons, utcDay } from '../src/lib/canaryBudget.ts';
import { ok } from './helpers.mts';
ok('an empty day leaves the free allowance less the margin', unusedNeurons({ spentToday: 0, visitorTurns: 0 }) === FREE_NEURONS_PER_DAY - MARGIN);
ok('visitors come first: each turn takes its Neurons off', unusedNeurons({ spentToday: 0, visitorTurns: 80 }) === FREE_NEURONS_PER_DAY - MARGIN - 80 * NEURONS_PER_TURN);
ok('what was already spent today comes off too', unusedNeurons({ spentToday: 3000, visitorTurns: 0 }) === FREE_NEURONS_PER_DAY - MARGIN - 3000);
ok('never negative, however much was used', unusedNeurons({ spentToday: 9500, visitorTurns: 400 }) === 0);
ok('a run starts only if a whole run fits', runsThatFit(NEURONS_PER_RUN - 1) === 0 && runsThatFit(NEURONS_PER_RUN) === 1 && runsThatFit(3500) === 3);
ok('at the cap of 80 turns and nothing else, several runs fit; with the default cap of 500 none do', runsThatFit(unusedNeurons({ spentToday: 0, visitorTurns: 80 })) >= 6 && runsThatFit(unusedNeurons({ spentToday: 0, visitorTurns: 500 })) === 0);
ok('the ledger day is the UTC day, which is when the allowance resets', utcDay(new Date('2026-11-16T23:59:00-06:00')) === '2026-11-17' && utcDay(new Date('2026-11-16T00:00:00Z')) === '2026-11-16');
ok('the ceiling is 3,000 a night however much is unused', NIGHTLY_CEILING === 3000 && canaryAllowance({ spentToday: 0, visitorTurns: 0 }) === 3000);
ok('what was already spent counts toward the ceiling, and the unused amount still limits it', canaryAllowance({ spentToday: 2500, visitorTurns: 0 }) === 500 && canaryAllowance({ spentToday: 0, visitorTurns: 300 }) === unusedNeurons({ spentToday: 0, visitorTurns: 300 }) && canaryAllowance({ spentToday: 3200, visitorTurns: 0 }) === 0);
import { readFileSync } from 'node:fs';
import { canaryKey } from '../src/lib/canaryBudget.ts';
const nightly = readFileSync('netlify/functions/canary-nightly.mts', 'utf8');
const run = readFileSync('netlify/functions/canary-run-background.mts', 'utf8');
ok('the key depends on the secret, and is not the secret', canaryKey('a') !== canaryKey('b') && !canaryKey('a').includes('a|') && canaryKey('a').length === 64);
ok('the nightly function is off unless COACH_CANARY=on, and runs at 23:30 UTC', /COACH_CANARY !== 'on'/.test(nightly) && /schedule: '30 23 \* \* \*'/.test(nightly));
ok('the background function refuses unless it is on and the key matches', /COACH_CANARY !== 'on'[\s\S]*x-canary-key[\s\S]*status: 404/.test(run));
ok('the canary never touches the real counters: the coach runs on an in-memory store', /__useStoreForTests\(\{/.test(run) && /mem = new Map/.test(run));
ok('it stops when the allowance or the time runs out, and keeps only counts and case ids', /allowance - spent >= MIN_CASE_NEURONS/.test(run) && /WALL_MS/.test(run) && /failedCases: failed/.test(run) && !/reply:/.test(run.slice(run.indexOf('const digest'), run.indexOf('await store.set(`canary/digest')))); 
