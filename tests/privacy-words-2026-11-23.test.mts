// Privacy words (2026-11-23): "privacy-first" and unqualified "private" about Nenya itself were replaced with what is true,
// using the owner's approved wording (1-replacements.md rows 1 to 23). Old phrases are gone from the changed files; new ones are present.
import { readFileSync } from 'node:fs';
import { ok } from './helpers.mts';

const read = (f: string): string => readFileSync(f, 'utf8');
const C = 'src/app/components/';

// Rows 2 to 7: the tagline, six places.
const taglineFiles = [
  C + 'pages/GatewayReviewPage.tsx', 'src/lib/nenyaPdfReport.ts', 'src/lib/legalPdf.ts',
  'scripts/build-answers-pdf.mts', 'scripts/lib/brandedPdf.mts',
];
for (const f of taglineFiles) {
  const t = read(f);
  ok(`${f}: no privacy-first, user-sovereign or open & transparent`, !/privacy-first|user-sovereign|open & transparent/i.test(t));
}
ok('GatewayReviewPage: text report tagline', read(C + 'pages/GatewayReviewPage.tsx').includes('Free • No account • No advertising'));
for (const f of ['src/lib/nenyaPdfReport.ts', 'src/lib/legalPdf.ts', 'scripts/build-answers-pdf.mts', 'scripts/lib/brandedPdf.mts']) {
  ok(`${f}: header tagline in capitals`, read(f).includes('FREE · NO ACCOUNT · NO ADVERTISING'));
}
ok('PDF report footer sentence form', read('src/lib/nenyaPdfReport.ts').includes('Generated by Nenya · nenya.biz · Free, no account, no advertising'));

// Row 1
const support = read(C + 'about/SupportUs.tsx');
ok('SupportUs: new card heading and body, old ones gone', support.includes('>No account, no ads</h4>') && support.includes('What you enter in the reflection tools stays on your device unless you choose to send it.') && !/Privacy-first|We do not track you/.test(support));

// Row 8 and 9
const evo = read(C + 'about/EvolvedLeadership.tsx');
ok('EvolvedLeadership: safety notice reworded', evo.includes('Nenya is built to keep little of what you enter, and its safety checks can be wrong, so it is important to proceed mindfully with its use.') && !/privacy-first/i.test(evo));
// 2026-11-24: the old closing note of the Venice page ("It would aim to work on your device where possible" and the Venice Mind sentence) left with the page's old content; the retirement note
// must still carry none of the old privacy overclaims.
const venice = read(C + 'about/VeniceChat.tsx');
ok('VeniceChat: the retirement note carries none of the old privacy overclaims', !/privacy-first|strong protection of personal details|only basic versions|Venice Mind|work on your device/.test(venice));

// Rows 10 to 19
const gone: Array<[string, RegExp]> = [
  [C + 'ShareNenya.tsx', /free, private/],
  [C + 'OnboardingFlow.tsx', /A private place/],
  [C + 'about/Mellonamin.tsx', /A Private Place/],
  [C + 'about/Structure.tsx', /A Private Artistic Project/],
  [C + 'about/NVCMethod.tsx', /in private\.|more private|a private place/],
  [C + 'DyadicCellCreation.tsx', /private, facilitated/],
  [C + 'about/PrivacyPromise.tsx', /a private record/],
  ['src/lib/nenyaPdfReport.ts', /private session|sensory gateways/],
  [C + 'WelcomeTutorial.tsx', /six gateways|and Insight\)|private report/],
  ['README.md', /A free, private/],
];
for (const [f, re] of gone) ok(`${f}: old phrase gone`, !re.test(read(f)));
const present: Array<[string, string]> = [
  [C + 'ShareNenya.tsx', 'Nenya: a free place to pause, breathe, and find words for what you feel.'],
  [C + 'OnboardingFlow.tsx', 'A free place to listen to yourself.'],
  [C + 'about/Mellonamin.tsx', 'What stays, and what leaves, your device'],
  [C + 'about/Structure.tsx', 'An Independent Artistic Project'],
  [C + 'about/NVCMethod.tsx', 'practicing the steps of NVC on your own.'],
  [C + 'about/NVCMethod.tsx', 'Nenya exists to make practicing NVC easier to reach.'],
  [C + 'about/NVCMethod.tsx', 'a free place to try the steps on your own before a real conversation.'],
  [C + 'DyadicCellCreation.tsx', 'Start a two-person dialogue (preview). Share this code with one person to begin.'],
  [C + 'about/PrivacyPromise.tsx', 'a record you keep over time. It would stay on your device.'],
  ['src/lib/nenyaPdfReport.ts', 'This report was made on your own device after a session of self-exploration with Nenya’s six lenses.'],
  [C + 'WelcomeTutorial.tsx', 'six lenses to explore (Sight, Sound, Touch, Essence, Movement and Pattern), and at the end you can save a report made in your own browser.'],
  ['README.md', 'A free, browser-based tool for structured personal reflection:'],
];
for (const [f, s] of present) ok(`${f}: new wording present (${s.slice(0, 30)}…)`, read(f).includes(s));

// Rows 20 to 22: public/about-nenya.html, the two copies of the FAQ question are identical.
const about = read('public/about-nenya.html');
const q = 'Is there a free, no-account way to check in with my emotions?';
ok('about-nenya.html: no "private way to check in" left', !/private way to check in/.test(about));
ok('about-nenya.html: JSON-LD question has the new text', about.includes(`"name": "${q}"`));
ok('about-nenya.html: visible FAQ question has the new text', about.includes(`<strong>${q}</strong>`));
ok('about-nenya.html: the two FAQ copies are identical (exactly two copies)', about.split(q).length === 3);
ok('about-nenya.html: "a free space to pause"', about.includes('a free space to pause, breathe, and engage'));
